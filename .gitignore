fuyubot_plugin.h
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.so
*.dylib
*.node
*.wasm
*.exe

# ── 本机开发缓存（td_api.tl / tdjson）──────────────────────────────────
.tdlib-cache/

# ── 示例里跑出来的东西 ────────────────────────────────────────────────
examples/*/target/
/data/

